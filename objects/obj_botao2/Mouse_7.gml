//mudando a variavel do modo de jogo 
// caso esteja no modo 1 jogador ele vai para 2 jogadores 

if (global.dois_jogadores == false)
{

	global.dois_jogadores=true;

}
else{// caso contratio ele está modo de 2 jogadores 

	global.dois_jogadores=false;// voltando para um jogador


}
















